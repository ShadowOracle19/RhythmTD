  tutorialText: {fileID: 157151448647524980}
  pressKeyToNextDialogue: 0
  cursorArrows: {fileID: 0}
  cursorMovementGlyphs: {fileID: 0}
  menuOpenGlyph: {fileID: 0}
  tutorialDialogue:
  - text: This is your <color=#FF0084>Stage
    isSkippableText: 1
  - text: <color=#FFFF00>Tap  <color=#FFF><sprite name="ArrowKeys"> to move
    isSkippableText: 1
  - text: Listen, or watch the cursor and metronome
    isSkippableText: 1
  - text: Aim for <color=#00D0FF>Great</color> or <color=#6FFF00>Perfect
    isSkippableText: 0
  - text: Move on-beat to gain <color=#FF00FF>magic
    isSkippableText: 0
  - text: <color=#FFFF00>Hold<color=#FFF> <sprite name="Space"> to open the <color=#FF0084>Tower
      Menu
    isSkippableText: 0
  - text: <color=#FFFF00>Tap<color=#FFF>   <sprite name="ArrowKeys"> to place a <color=#FF0084>Tower
    isSkippableText: 0
  - text: <color=#FF0084>Enemies <color=#FFF>damage <color=#FF0084>Towers <color=#FFF>when
      they collide
    isSkippableText: 1
  - text: <color=#FF0084>Towers <color=#FFF>play automatically...
    isSkippableText: 1
  - text: ...but get <color=#FF0000>stronger <color=#FFFFFF>when you play along
    isSkippableText: 1
  - text: Move to a <color=#FF0084>Tower
    isSkippableText: 0
  - text: <color=#FFFF00>Tap <color=#FF0084>Z<color=#FFF>, <color=#00ffea>X<color=#FFF>,
      <color=#00c36d>C<color=#FFF>, or <color=#FF0000>V <color=#FFF>when the ring
      touches the center circle
    isSkippableText: 0
  - text: <color=#FF0084>Towers <color=#FFF>will copy your performance
    isSkippableText: 1
  - text: Try playing different keys!
    isSkippableText: 1
  - text: Now...
    isSkippableText: 1
  - text: <color=#FF0084>Knock 'em Dead!
    isSkippableText: 1
