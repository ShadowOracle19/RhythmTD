    - target: {fileID: 8313486990234526355, guid: 1b6ba74460c615349ba541b3e3a36735, type: 3}
      propertyPath: tutorialDialogue.Array.data[0].text
      value: This is your <color=#FF0084>Stage
      objectReference: {fileID: 0}
    - target: {fileID: 8313486990234526355, guid: 1b6ba74460c615349ba541b3e3a36735, type: 3}
      propertyPath: tutorialDialogue.Array.data[1].text
      value: <color=#FFFF00>Tap  <color=#FFF><sprite name="ArrowKeys"> to move
      objectReference: {fileID: 0}
    - target: {fileID: 8313486990234526355, guid: 1b6ba74460c615349ba541b3e3a36735, type: 3}
      propertyPath: tutorialDialogue.Array.data[2].text
      value: Listen, or watch the cursor and metronome
      objectReference: {fileID: 0}
    - target: {fileID: 8313486990234526355, guid: 1b6ba74460c615349ba541b3e3a36735, type: 3}
      propertyPath: tutorialDialogue.Array.data[3].text
      value: Aim for <color=#00D0FF>Great</color> or <color=#6FFF00>Perfect
      objectReference: {fileID: 0}
    - target: {fileID: 8313486990234526355, guid: 1b6ba74460c615349ba541b3e3a36735, type: 3}
      propertyPath: tutorialDialogue.Array.data[4].text
      value: Move on-beat to gain <color=#FF00FF>magic
      objectReference: {fileID: 0}
    - target: {fileID: 8313486990234526355, guid: 1b6ba74460c615349ba541b3e3a36735, type: 3}
      propertyPath: tutorialDialogue.Array.data[5].text
      value: <color=#FFFF00>Hold<color=#FFF> <sprite name="Space"> to open the <color=#FF0084>Tower
        Menu
      objectReference: {fileID: 0}
    - target: {fileID: 8313486990234526355, guid: 1b6ba74460c615349ba541b3e3a36735, type: 3}
      propertyPath: tutorialDialogue.Array.data[6].text
      value: <color=#FFFF00>Tap<color=#FFF>   <sprite name="ArrowKeys"> to place
        a <color=#FF0084>Tower
      objectReference: {fileID: 0}
    - target: {fileID: 8313486990234526355, guid: 1b6ba74460c615349ba541b3e3a36735, type: 3}
      propertyPath: tutorialDialogue.Array.data[7].text
      value: <color=#FF0084>Enemies <color=#FFF>damage <color=#FF0084>Towers <color=#FFF>when
        they collide
      objectReference: {fileID: 0}
    - target: {fileID: 8313486990234526355, guid: 1b6ba74460c615349ba541b3e3a36735, type: 3}
      propertyPath: tutorialDialogue.Array.data[8].text
      value: <color=#FF0084>Towers <color=#FFF>play automatically...
      objectReference: {fileID: 0}
    - target: {fileID: 8313486990234526355, guid: 1b6ba74460c615349ba541b3e3a36735, type: 3}
      propertyPath: tutorialDialogue.Array.data[9].text
      value: ...but get <color=#FF0000>stronger <color=#FFFFFF>when you play along
      objectReference: {fileID: 0}
    - target: {fileID: 8313486990234526355, guid: 1b6ba74460c615349ba541b3e3a36735, type: 3}
      propertyPath: tutorialDialogue.Array.data[10].text
      value: Move to a <color=#FF0084>Tower
      objectReference: {fileID: 0}
    - target: {fileID: 8313486990234526355, guid: 1b6ba74460c615349ba541b3e3a36735, type: 3}
      propertyPath: tutorialDialogue.Array.data[11].text
      value: <color=#FFFF00>Tap <color=#FF0084>Z<color=#FFF>, <color=#00ffea>X<color=#FFF>,
        <color=#00c36d>C<color=#FFF>, or <color=#FF0000>V <color=#FFF>when the ring
        touches the center circle
      objectReference: {fileID: 0}
    - target: {fileID: 8313486990234526355, guid: 1b6ba74460c615349ba541b3e3a36735, type: 3}
      propertyPath: tutorialDialogue.Array.data[12].text
      value: <color=#FF0084>Towers <color=#FFF>will copy your performance
      objectReference: {fileID: 0}
    - target: {fileID: 8313486990234526355, guid: 1b6ba74460c615349ba541b3e3a36735, type: 3}
      propertyPath: tutorialDialogue.Array.data[13].text
      value: Try playing different keys!
      objectReference: {fileID: 0}
    - target: {fileID: 8313486990234526355, guid: 1b6ba74460c615349ba541b3e3a36735, type: 3}
      propertyPath: tutorialDialogue.Array.data[14].text
      value: Now...
      objectReference: {fileID: 0}
    - target: {fileID: 8313486990234526355, guid: 1b6ba74460c615349ba541b3e3a36735, type: 3}
      propertyPath: tutorialDialogue.Array.data[15].text
      value: <color=#FF0084>Knock 'em Dead!
