    isSkippableText: 0
  - text: <color=#FFFF00>Tap<color=#FFF>   <sprite name="ArrowKeys"> to place a <color=#FF0084>Robot
    isSkippableText: 0
  - text: <color=#FF0084>Enemies <color=#FFF>damage <color=#FF0084>Robots <color=#FFF>when
      they collide
    isSkippableText: 1
  - text: <color=#FF0084>Robots <color=#FFF>play automatically...
    isSkippableText: 1
  - text: ...but get <color=#FF0000>stronger <color=#FFFFFF>when you play along
    isSkippableText: 1
  - text: Move to a <color=#FF0084>Robot
    isSkippableText: 0
  - text: <color=#FFFF00>Tap <color=#FF0084>Z<color=#FFF> <color=#FFF>when the ring
      touches the center circle
