  tutorialDialogue:
  - text: This is your <color=#FF0084>Stage
    isSkippableText: 1
  - text: <color=#FFFF00>Tap  <color=#FFF><sprite name="ArrowKeys"> to move
    isSkippableText: 1
  - text: Listen, or watch the cursor and metronome
    isSkippableText: 1
  - text: Aim for <color=#00D0FF>Great</color> or <color=#6FFF00>Perfect
    isSkippableText: 0
  - text: Move on-beat to gain <color=#FF00FF>Energy
    isSkippableText: 0
  - text: <color=#FFFF00>Hold<color=#FFF> <sprite name="Space"> to open the <color=#FF0084>Tower
