  tutorialDialogue:
  - text: This is your <color=#FF0084>stage
    isSkippableText: 1
  - text: Use  <sprite name="ArrowKeys">to <color=#FF0084>move
    isSkippableText: 1
  - text: ' Try to move <color=#FF0084>on-beat'
    isSkippableText: 1
  - text: Listen, or watch the cursor and metronome
    isSkippableText: 1
  - text: Aim for <color=#00D0FF>Great</color> or <color=#6FFF00>Perfect
    isSkippableText: 0
  - text: moving on-beat gives <color=#FF0084>magic
    isSkippableText: 0
  - text: Press <sprite name="Space"> to open the <color=#FF0084>Tower Menu
    isSkippableText: 0
  - text: Press <sprite name="ArrowKeys"> to place a tower
    isSkippableText: 0
  - text: Enemies damage towers when they collide
    isSkippableText: 1
  - text: Try placing more towers
    isSkippableText: 1
  - text: Towers perform weak attacks automatically
    isSkippableText: 1
  - text: playing in time with attacks, buffs them
    isSkippableText: 1
  - text: Move to a tower
    isSkippableText: 1
  - text: Press Z, X, C, or V when the ring reaches the center circle
    isSkippableText: 0
  - text: Towers repeat buffed attacks for a time
    isSkippableText: 1
  - text: <color=#6FFF00>Perfect</color> results make buffs stronger
    isSkippableText: 1
  - text: Towers will copy new performances
    isSkippableText: 1
  - text: Don't let the enemies reach the end
    isSkippableText: 1
  - text: Now...
    isSkippableText: 1
  - text: <color=#FF0084>Knock 'em Dead!
    isSkippableText: 1
